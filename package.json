{
    "name": "achievement-companion",
    "version": "1.0.1",
    "description": "Displays achievements from RetroAchievements, local Steam emulator saves, and other sources in Steam.",
    "type": "module",
    "main": "./frontend/index.tsx",
    "author": "leonardo.oliveira",
    "license": "MIT",
    "scripts": {
        "dev": "millennium-ttc --build dev",
        "build": "millennium-ttc --build prod",
        "watch": "nodemon --watch frontend --ext ts,tsx --exec \"millennium-ttc --build dev\""
    },
    "devDependencies": {
        "@babel/preset-env": "^7.28.3",
        "@babel/preset-react": "^7.27.1",
        "@babel/traverse": "^7.28.3",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/webpack": "^5.28.5",
        "nodemon": "^3"
    },
    "dependencies": {
        "@steambrew/api": "^5.5.3",
        "@steambrew/client": "^5.5.3",
        "@steambrew/ttc": "^2.7.3",
        "@steambrew/webkit": "^5.5.3"
    }
}
